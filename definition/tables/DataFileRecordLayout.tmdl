						[
							Delimiter = ",",
							Columns = 20,
							Encoding = 65001,
							QuoteStyle = QuoteStyle.None
						]
					),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					#"Changed Type" = Table.TransformColumnTypes(
						#"Promoted Headers",
						{
							{"REF_DATE", type text},
							{"GEO", type text},
							{"DGUID", type text},
							{"Educational qualification", type text},
							{"Field of study", type text},
							{"Gender", type text},
							{"Age group", type text},
							{"Population group", type text},
							{"Indicator", type text},
							{"UOM", type text},
							{"UOM_ID", Int64.Type},
							{"SCALAR_FACTOR", type text},
							{"SCALAR_ID", Int64.Type},
							{"VECTOR", type text},
							{"COORDINATE", type text},
							{"VALUE", Int64.Type},
							{"STATUS", type text},
