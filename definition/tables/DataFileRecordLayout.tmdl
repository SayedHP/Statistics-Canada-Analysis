table DataFileRecordLayout
	lineageTag: a1fb0955-333a-4eec-b217-545208c28e69

	measure 'Total Graduates' = SUM('DataFileRecordLayout'[VALUE])
		lineageTag: 79be8270-6c72-44c3-a03a-8cd1a6c3fe0c

	measure 'Female Percentage' =
			DIVIDE(
				[Female Graduates],
				[Total Graduates],
				0
			)
		lineageTag: 622e49f7-3d53-44f2-b557-40c9427b1088

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total graduates filtered for women - Optimized to use direct SUM
	measure 'Female Graduates' =
			CALCULATE(
			    SUM('DataFileRecordLayout'[VALUE]),
			    'DataFileRecordLayout'[Gender] = "Woman"
			)
		formatString: 0
		lineageTag: cdcbf9ac-b99a-4157-a151-63c6a9639387

	measure 'Number of Provinces' = DISTINCTCOUNT('DataFileRecordLayout'[GEO])
		formatString: 0
		lineageTag: 2b5f1d5f-888e-49d3-addb-0fbeaeef8fab

	measure 'First Year' = MIN('DataFileRecordLayout'[REF_DATE])
		lineageTag: 2494f880-6507-46b9-86db-c6351a2e97cf

	measure 'Last Year' = MAX('DataFileRecordLayout'[REF_DATE])
		lineageTag: d198c552-2474-45b7-993f-2c8dab33f2f0

	/// Year-over-year percentage change - Optimized with direct SUM and better error handling
	measure 'Graduates YofY Change (%)' = ```
			VAR CurrentValue = SUM('DataFileRecordLayout'[VALUE])
			VAR CurrentYear = SELECTEDVALUE('DataFileRecordLayout'[REF_DATE])
			VAR PriorYearValue = 
			    CALCULATE(
			        SUM('DataFileRecordLayout'[VALUE]),
			        'DataFileRecordLayout'[REF_DATE] = FORMAT(VALUE(CurrentYear) - 1, "0")
			    )
			RETURN
			    DIVIDE(
			        CurrentValue - PriorYearValue,
			        PriorYearValue,
			        BLANK()
			    )
			```
		formatString: 0.00%
		lineageTag: 6d31e9b1-bff2-4aee-82ac-c6f5cb3f8202

	/// Total graduates filtered for men
	measure 'Male Graduates' =
			CALCULATE(
			    SUM('DataFileRecordLayout'[VALUE]),
			    'DataFileRecordLayout'[Gender] = "Man"
			)
		formatString: 0

	/// Percentage of male graduates
	measure 'Male Percentage' =
			DIVIDE(
			    [Male Graduates],
			    [Total Graduates],
			    BLANK()
			)
		formatString: 0.00%

	/// Gender diversity ratio (closer to 1.0 means more balanced)
	measure 'Gender Balance Ratio' =
			VAR FemaleCount = [Female Graduates]
			VAR MaleCount = [Male Graduates]
			VAR MinValue = MIN(FemaleCount, MaleCount)
			VAR MaxValue = MAX(FemaleCount, MaleCount)
			RETURN
			    DIVIDE(MinValue, MaxValue, BLANK())
		formatString: 0.00

	/// Average graduates per province
	measure 'Avg Graduates per Province' =
			DIVIDE(
			    [Total Graduates],
			    [Number of Provinces],
			    BLANK()
			)
		formatString: #,##0

	/// Running total of graduates over time
	measure 'Cumulative Graduates' =
			CALCULATE(
			    [Total Graduates],
			    FILTER(
			        ALLSELECTED('DataFileRecordLayout'[REF_DATE]),
			        'DataFileRecordLayout'[REF_DATE] <= MAX('DataFileRecordLayout'[REF_DATE])
			    )
			)
		formatString: #,##0

	/// Graduates in the most recent year available - Fixed to avoid placeholder errors
	measure 'Latest Year Graduates' =
			VAR MaxYear = MAX('DataFileRecordLayout'[REF_DATE])
			RETURN
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = MaxYear
			    )
		formatString: #,##0

	/// Year-over-year absolute change in graduates
	measure 'Graduates YoY Change (Absolute)' = ```
			VAR CurrentValue = [Total Graduates]
			VAR CurrentYear = SELECTEDVALUE('DataFileRecordLayout'[REF_DATE])
			VAR PriorYearValue = 
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = FORMAT(VALUE(CurrentYear) - 1, "0")
			    )
			RETURN
			    CurrentValue - PriorYearValue
			```
		formatString: +#,##0;-#,##0;0

	/// Percentage of current selection vs total across all contexts
	measure '% of Total Graduates' =
			DIVIDE(
			    [Total Graduates],
			    CALCULATE([Total Graduates], ALL('DataFileRecordLayout')),
			    BLANK()
			)
		formatString: 0.00%

	/// Rank provinces by number of graduates (1=highest)
	measure 'Province Rank by Graduates' =
			IF(
			    ISINSCOPE('DataFileRecordLayout'[GEO]),
			    RANKX(
			        ALLSELECTED('DataFileRecordLayout'[GEO]),
			        [Total Graduates],
			        ,
			        DESC,
			        DENSE
			    ),
			    BLANK()
			)
		formatString: 0

	/// Moving average of graduates over 3 years
	measure '3-Year Moving Avg' = ```
			VAR CurrentYear = SELECTEDVALUE('DataFileRecordLayout'[REF_DATE])
			VAR YearTable = 
			    FILTER(
			        ALLSELECTED('DataFileRecordLayout'[REF_DATE]),
			        VALUE('DataFileRecordLayout'[REF_DATE]) >= VALUE(CurrentYear) - 2 &&
			        VALUE('DataFileRecordLayout'[REF_DATE]) <= VALUE(CurrentYear)
			    )
			VAR YearsCount = COUNTROWS(YearTable)
			RETURN
			    IF(
			        YearsCount >= 2,
			        CALCULATE(
			            [Total Graduates],
			            YearTable
			        ) / YearsCount,
			        BLANK()
			    )
			```
		formatString: #,##0

	/// Total growth from first to last year - Fixed to avoid placeholder errors
	measure 'Total Period Growth %' = ```
			VAR MinYear = MIN('DataFileRecordLayout'[REF_DATE])
			VAR MaxYear = MAX('DataFileRecordLayout'[REF_DATE])
			VAR FirstYearValue = 
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = MinYear
			    )
			VAR LastYearValue = 
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = MaxYear
			    )
			RETURN
			    DIVIDE(
			        LastYearValue - FirstYearValue,
			        FirstYearValue,
			        BLANK()
			    )
			```
		formatString: 0.00%

	/// Compound annual growth rate over the entire period - Fixed to avoid placeholder errors
	measure CAGR = ```
			VAR MinYear = MIN('DataFileRecordLayout'[REF_DATE])
			VAR MaxYear = MAX('DataFileRecordLayout'[REF_DATE])
			VAR FirstYearValue = 
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = MinYear
			    )
			VAR LastYearValue = 
			    CALCULATE(
			        [Total Graduates],
			        'DataFileRecordLayout'[REF_DATE] = MaxYear
			    )
			VAR YearsCount = VALUE(MaxYear) - VALUE(MinYear)
			RETURN
			    IF(
			        YearsCount > 0 && FirstYearValue > 0,
			        POWER(LastYearValue / FirstYearValue, 1 / YearsCount) - 1,
			        BLANK()
			    )
			```
		formatString: 0.00%

	/// Number of distinct fields of study
	measure 'Number of Fields of Study' = DISTINCTCOUNT('DataFileRecordLayout'[Field of study])
		formatString: 0

	/// Visual indicator: Up arrow, down arrow, or neutral based on YoY change
	measure 'Growth Trend Indicator' =
			VAR YoYChange = [Graduates YofY Change (%)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(YoYChange), "–",
			        YoYChange > 0.02, "↑ Increase",
			        YoYChange < -0.02, "↓ Decrease",
			        "→ Stable"
			    )

